# In development the app runs in demo mode by default: a sample database on
# the device, no sign-in, and none of the values below are needed. Copy this
# file to mobile/.env only when you want the real thing.
#
# Set this to turn demo mode off and use the real Supabase project, its data
# and its sign-in screen. Anything else, including leaving it out, means demo.
# EXPO_PUBLIC_DEMO_MODE=off
#
# Supabase dashboard -> Project Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase dashboard -> Project Settings -> API Keys -> Publishable key
# (sb_publishable_...). Safe to ship in the app: it grants nothing on its own,
# and every request is still filtered by row-level security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where tour links live. Used to build shareable links and as the web fallback
# for clients who have not installed the app.
EXPO_PUBLIC_SITE_URL=https://crepropertytour.vercel.app

# ── Optional, development only ───────────────────────────────────────────
# Fill these in and the app signs you in on launch, so reloading while you
# work does not mean retyping a password. It signs in as a real broker, so
# every security rule still applies -- this is a convenience, not a bypass.
#
# Never runs in a release build, and this file is never committed. Delete
# the two lines to go back to typing it.
# EXPO_PUBLIC_DEV_EMAIL=you@cresa.com
# EXPO_PUBLIC_DEV_PASSWORD=your-password
