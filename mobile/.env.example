# Copy to mobile/.env and fill in. Same two values the website uses.
#
# Supabase dashboard -> Project Settings -> Data API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase dashboard -> Project Settings -> API Keys -> Publishable key
# (sb_publishable_...). Safe to ship in the app: it grants nothing on its own,
# and every request is still filtered by row-level security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where tour links live. Used to build shareable links and as the web fallback
# for clients who have not installed the app.
EXPO_PUBLIC_SITE_URL=https://crepropertytour.vercel.app
