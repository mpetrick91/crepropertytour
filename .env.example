# Copy to .env.local and fill in from your Supabase project.

# Project URL, e.g. https://abcdefghijklm.supabase.co
# Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# On older projects this is the "anon" key (a JWT starting eyJ...); both work, and
# the variable keeps the historical ANON name because that is what the ecosystem
# expects. Safe to expose to the browser: it carries no privileges of its own,
# and every request is still filtered by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL -- nothing in the app imports this today. It is the secret key
# (sb_secret_... / service_role) and it BYPASSES RLS entirely, so leave it unset
# unless you are adding genuine admin work. Server-side only, never prefixed with
# NEXT_PUBLIC_, never committed.
# SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin used to build magic-link redirects. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://tours.example.com

# Optional: satellite imagery on a building's page.
#
# Server-side only, deliberately -- this key is never sent to the app or the
# browser. /api/aerial holds it and forwards the request, because a key shipped
# inside an app can be read and spent by anyone who downloads it, and static
# map requests carry no referrer or bundle id to restrict against.
#
# Google Cloud -> APIs & Services -> Credentials -> Create credentials -> API key,
# with the Maps Static API enabled. Set a daily quota cap on it.
# MAPS_KEY=
