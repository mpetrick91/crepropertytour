# Copy to .env.local and fill in from your Supabase project.
# Dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon/publishable key. Safe to expose to the browser: it carries no
# privileges of its own, and every request is still filtered by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service_role key. BYPASSES RLS -- server-side only, never prefixed with
# NEXT_PUBLIC_, never committed. Only needed for admin/maintenance work.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin used to build magic-link redirects. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://tours.example.com
